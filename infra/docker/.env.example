# Skopiuj do infra/docker/.env i uzupełnij. Plik .env nie trafia do repozytorium.
POSTGRES_PASSWORD=zmien-na-dlugie-losowe-haslo
LLM_MODEL_NAME=gpt-6-luna
LLM_ALLOWED_MODELS=gpt-6-luna
# OBSIL_PORT=3000

# Logowanie. Na komputerze AJ: local. Na VPS: cloudflare + dane aplikacji z Cloudflare Zero Trust.
AUTH_MODE=local
# CF_ACCESS_TEAM_DOMAIN=nazwa-zespolu.cloudflareaccess.com
# CF_ACCESS_AUD=application-audience-tag
# Adresy z rolą operatora (rozdzielone przecinkami); pozostali zalogowani to testerzy.
