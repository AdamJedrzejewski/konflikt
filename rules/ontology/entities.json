{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OBSIL Ontology — Entities, Relations, Matter Types, Risk Levels",
  "version": "1.1.0",

  "entity_types": [
    {
      "id": "radca_prawny",
      "label_pl": "Radca prawny",
      "description_pl": "Osoba wpisana na liste radcow prawnych, swiadczaca pomoc prawna",
      "examples": [
        "radca prawny prowadzacy kancelarie",
        "radca prawny zatrudniony w spolce",
        "radca prawny wykonujacy zawod na podstawie umowy cywilnoprawnej"
      ]
    },
    {
      "id": "klient_aktualny",
      "label_pl": "Klient aktualny",
      "description_pl": "Kazdy, na rzecz ktorego radca prawny aktualnie swiadczy pomoc prawna (art. 5 pkt 4 KERP)",
      "examples": [
        "osoba fizyczna reprezentowana w postepowaniu",
        "spolka, na rzecz ktorej radca prawny doradza",
        "organ administracji korzystajacy z obslugi prawnej"
      ]
    },
    {
      "id": "klient_byly",
      "label_pl": "Klient byly",
      "description_pl": "Osoba, na rzecz ktorej radca prawny uprzednio wykonywal czynnosci zawodowe",
      "examples": [
        "klient, ktorego sprawe radca prowadzil w przeszlosci",
        "spolka, ktorej radca doradzal przed zakonczeniem wspolpracy"
      ]
    },
    {
      "id": "osoba_najblizsha",
      "label_pl": "Osoba najblizsha radcy prawnego",
      "description_pl": "Osoba z art. 115 par. 11 k.k.: malzonek, wstepny, zstepny, rodzenstwo, powinowaty w tej samej linii lub stopniu, osoba pozostajaca w stosunku przysposobienia oraz jej malzonek, osoba pozostajaca we wspolnym pozyciu (art. 5 pkt 7 KERP)",
      "examples": [
        "malzonek radcy prawnego",
        "rodzic lub dziecko radcy prawnego",
        "rodzenstwo radcy prawnego",
        "partner zyciowy radcy prawnego (wspolne pozycie)"
      ]
    },
    {
      "id": "wspolnik_kancelarii",
      "label_pl": "Wspolnik kancelarii",
      "description_pl": "Osoba, ktora zgodnie z przepisami u.r.p. moze byc wspolnikiem spolki, w ktorej radca prawny wykonuje zawod (art. 5 pkt 6 KERP, art. 8 u.r.p.)",
      "examples": [
        "inny radca prawny w tej samej kancelarii",
        "adwokat bedacy wspolnikiem spolki partnerskiej",
        "doradca podatkowy bedacy wspolnikiem spolki jawnej"
      ]
    },
    {
      "id": "strona_przeciwna",
      "label_pl": "Strona przeciwna",
      "description_pl": "Przeciwnik procesowy klienta lub osoba zainteresowana niekorzystnym dla klienta rozstrzygnieciem sprawy",
      "examples": [
        "pozwany w sprawie cywilnej klienta",
        "oskarzyciel w sprawie karnej klienta",
        "organ administracji wydajacy niekorzystna decyzje"
      ]
    },
    {
      "id": "organ_wladzy_publicznej",
      "label_pl": "Organ wladzy publicznej",
      "description_pl": "Przedstawiciel organow wladzy publicznej, w ktorych radca prawny uprzednio bral udzial (art. 27 pkt 1 KERP)",
      "examples": [
        "sedzia orzekajacy w sprawie",
        "prokurator prowadzacy postepowanie",
        "organ administracji rozstrzygajacy sprawe"
      ]
    },
    {
      "id": "arbiter_mediator_biegly",
      "label_pl": "Arbiter / mediator / biegly",
      "description_pl": "Rola procesowa, w ktorej radca prawny bral wczesniej udzial w sprawie (art. 27 pkt 1 KERP)",
      "examples": [
        "arbiter w postepowaniu arbitrazowym",
        "mediator w mediacji miedzy stronami",
        "biegly powolany w postepowaniu"
      ]
    },
    {
      "id": "swiadek",
      "label_pl": "Swiadek",
      "description_pl": "Osoba zeznajaca w postepowaniu o okolicznosciach sprawy (art. 27 pkt 2 KERP)",
      "examples": [
        "swiadek zeznajacy przed sadem",
        "swiadek przesluchany w postepowaniu przygotowawczym"
      ]
    },
    {
      "id": "pelniacy_funkcje_publiczna",
      "label_pl": "Pelniacy funkcje publiczna",
      "description_pl": "Osoba pelniaca funkcje publiczna, w ktorej to roli radca prawny wczesniej braI udzial w sprawie (art. 27 pkt 1 KERP)",
      "examples": [
        "czlonek komisji administracyjnej rozstrzygajacej sprawe",
        "funkcjonariusz publiczny uczestniczacy w postepowaniu"
      ]
    }
  ],

  "relationship_types": [
    {
      "id": "pelnomocnik_obronca",
