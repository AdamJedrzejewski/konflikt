    {
      "id": "wspolnik_kancelarii_relacja",
      "label_pl": "Wspolnik kancelarii",
      "description_pl": "Wspolne wykonywanie zawodu w ramach kancelarii (art. 8 u.r.p.)",
      "between": [
        ["radca_prawny", "wspolnik_kancelarii"]
      ],
      "relevant_articles": ["art. 5 pkt 6 KERP", "art. 26a KERP", "art. 27 pkt 4 KERP", "art. 8 u.r.p."]
    },
    {
      "id": "bliskie_stosunki",
      "label_pl": "Bliskie stosunki",
      "description_pl": "Bliskie stosunki radcy prawnego z przeciwnikiem klienta lub osoba zainteresowana niekorzystnym rozstrzygnieciem (art. 27 pkt 5 KERP)",
      "between": [
        ["radca_prawny", "strona_przeciwna"],
        ["radca_prawny", "klient_aktualny"],
        ["radca_prawny", "klient_byly"],
        ["radca_prawny", "osoba_najblizsha"],
        ["radca_prawny", "wspolnik_kancelarii"],
        ["radca_prawny", "organ_wladzy_publicznej"],
        ["radca_prawny", "arbiter_mediator_biegly"],
        ["radca_prawny", "swiadek"],
        ["radca_prawny", "pelniacy_funkcje_publiczna"]
      ],
      "relevant_articles": ["art. 27 pkt 5 KERP"]
    },
    {
      "id": "stosunek_zaleznosci",
      "label_pl": "Stosunek zaleznosci",
      "description_pl": "Stosunek zaleznosci z osoba biorace lub bral udzial w rozstrzygnieciu sprawy (art. 27 pkt 3 KERP)",
      "between": [
        ["radca_prawny", "strona_przeciwna"],
        ["radca_prawny", "klient_aktualny"],
        ["radca_prawny", "klient_byly"],
        ["radca_prawny", "osoba_najblizsha"],
        ["radca_prawny", "wspolnik_kancelarii"],
        ["radca_prawny", "organ_wladzy_publicznej"],
        ["radca_prawny", "arbiter_mediator_biegly"],
        ["radca_prawny", "swiadek"],
        ["radca_prawny", "pelniacy_funkcje_publiczna"]
      ],
      "relevant_articles": ["art. 27 pkt 3 KERP", "art. 15 u.r.p."]
    },
    {
      "id": "przeciwnik_procesowy",
      "label_pl": "Przeciwnik procesowy",
      "description_pl": "Relacja przeciwstawnosci procesowej miedzy klientem a strona przeciwna",
      "between": [
        ["klient_aktualny", "strona_przeciwna"],
        ["klient_byly", "strona_przeciwna"]
      ],
      "relevant_articles": ["art. 28 ust. 2 KERP"]
    },
    {
      "id": "uprzednia_reprezentacja",
      "label_pl": "Uprzednia reprezentacja",
      "description_pl": "Radca prawny uprzednio wykonywal czynnosci zawodowe na rzecz bylego klienta w tej samej sprawie lub sprawie z nia zwiazanej",
      "between": [
        ["radca_prawny", "klient_byly"]
      ],
      "relevant_articles": ["art. 28 ust. 3 KERP", "art. 29 ust. 1 pkt 2 KERP"]
    }
  ],

