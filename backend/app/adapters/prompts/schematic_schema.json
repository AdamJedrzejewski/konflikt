{"$schema": "http://json-schema.org/draft-07/schema#", "title": "OBSIL Schematic Analysis Output", "description": "Schema walidujacy output analizy schematycznej (drzewo decyzyjne KERP)", "type": "object", "required": ["configurations_checked", "schematic_result", "triggered_absolute", "triggered_waivable", "schematic_confidence", "stop_reason"], "additionalProperties": false, "properties": {"configurations_checked": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["configuration", "article", "triggered_rules", "result", "reason"], "additionalProperties": false, "properties": {"configuration": {"type": "string", "enum": ["konfiguracja_2", "konfiguracja_1", "konfiguracja_3_pelnomocnictwo", "konfiguracja_3_doradztwo", "konfiguracja_4_pelnomocnictwo", "konfiguracja_4_doradztwo", "klauzula_generalna", "konfiguracja_kancelaryjna"], "description": "Identyfikator konfiguracji z drzewa decyzyjnego"}, "article": {"type": "string", "minLength": 1, "description": "Artykul KERP (np. 'art. 27 pkt 1-6 KERP')"}, "triggered_rules": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "ID regul aktywowanych w tej konfiguracji"}, "result": {"type": "string", "enum": ["CONFLICT", "NO_CONFLICT", "UNCLEAR"], "description": "Wynik sprawdzenia konfiguracji"}, "reason": {"type": "string", "minLength": 1, "description": "Uzasadnienie po polsku odnoszace sie do faktow z ekstrakcji"}}}}, "schematic_result": {"type": "string", "enum": ["CONFLICT", "NO_CONFLICT", "CONFLICT_WAIVABLE", "UNCLEAR"], "description": "Koncowy wynik analizy schematycznej"}, "triggered_absolute": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "ID regul bezwzglednych aktywowanych w analizie"}, "triggered_waivable": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "ID regul uchylalnych aktywowanych w analizie"}, "schematic_confidence": {"type": "string", "enum": ["wysoka", "srednia", "niska"], "description": "Poziom pewnosci analizy schematycznej"}, "stop_reason": {"type": ["string", "null"], "description": "Przyczyna przerwania analizy (STOP) lub null jezeli analiza przeszla wszystkie kroki"}}}