# Local ChatGPT subscription connection. Codex manages login; no tokens here.
LLM_PROVIDER=codex_chatgpt
LLM_MODEL_NAME=gpt-6-astra
CODEX_REASONING_EFFORT=medium
LLM_TIMEOUT_SECONDS=600
KNOWLEDGE_MODE=experimental
LOCAL_TEST_MODE=true
# Start from the backend directory; this database contains local test cases only.
DATABASE_URL=sqlite+aiosqlite:///./obsil-test.sqlite3
